# OpenAI / LLM
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Agno
AGNO_API_KEY=

# Production / Dev mode
# Set TOOLKINETIK_DEV=1 for development (allows API-key auto-generation).
# In production, AGNO_API_KEY MUST be set explicitly — auto-gen is refused.
TOOLKINETIK_DEV=

# Sandbox
SANDBOX_IMAGE=python:3.12-slim

# Paths
SKILLS_DIR=skills/
DB_PATH=data/toolkinetik.db